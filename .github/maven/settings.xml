<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings of the GitHub Actions builds, installed as ~/.m2/settings.xml by .github/actions/maven-settings.
     The credentials are environment variables (Maven resolves ${env.X} itself), nothing secret is stored here:
       GLOBAL_ARTIFACTS_USER / GLOBAL_ARTIFACTS_TOKEN   Talend/global-artifacts (GitHub Packages), set by the workflow -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <!-- same id as the repository below and in -DaltDeploymentRepository -->
    <server>
      <id>global-artifacts</id>
      <username>${env.GLOBAL_ARTIFACTS_USER}</username>
      <password>${env.GLOBAL_ARTIFACTS_TOKEN}</password>
    </server>
  </servers>

  <!-- Already published Syncope GAVs (the modules not rebuilt are resolved from there) -->
  <profiles>
    <profile>
      <id>global-artifacts</id>
      <repositories>
        <repository>
          <id>global-artifacts</id>
          <url>https://maven.pkg.github.com/Talend/global-artifacts</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>global-artifacts</activeProfile>
  </activeProfiles>
</settings>
